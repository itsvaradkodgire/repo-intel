# Repository Intelligence Platform — environment variables (all OPTIONAL).
# Copy to `.env` for local dev, or set these in your host's dashboard (Render etc).
# The app runs fully without any of these (public repos + no login).

# ---- Server ----
# PORT is injected by most hosts; defaults to 4477 locally.
# PORT=4477
# Where the git clone cache lives (defaults to ~/.repo-intel-cache).
# REPO_INTEL_CACHE=/tmp/repo-intel-cache

# ---- "Sign in with GitHub" (OAuth) : browse & analyze YOUR OWN repos ----
# Create an OAuth App at https://github.com/settings/developers -> New OAuth App.
#   Authorization callback URL: https://YOUR-HOST/api/auth/github/callback
#   (for local dev use http://localhost:4477/api/auth/github/callback)
# GITHUB_OAUTH_CLIENT_ID=Iv1_xxxxxxxxxxxx
# GITHUB_OAUTH_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: force the callback origin (else derived from the request host).
# GITHUB_OAUTH_CALLBACK_BASE=https://your-host.onrender.com
# Optional: override scopes (default "repo read:user"). Use "public_repo read:user"
# if you only want public-repo access.
# GITHUB_OAUTH_SCOPE=repo read:user

# ---- GitHub App : org-wide, least-privilege private access (alternative) ----
# See src/github/README.md. Only needed for the App flow, not OAuth login.
# GITHUB_APP_ID=123456
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
